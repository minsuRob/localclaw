# ============================================================
# OpenClaw 설정
# ============================================================
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_CONFIG_DIR=/Users/REPLACE_WITH_YOUR_USERNAME/.openclaw
# 에이전트 workspace = 이 레포 루트 (Docker는 /home/node/.openclaw/workspace 로 마운트됨)
OPENCLAW_WORKSPACE_DIR=/Users/REPLACE_WITH_YOUR_USERNAME/Workspace/Personal/localclaw
# docker | native — sync-openclaw-config.sh 가 workspace 경로를 맞출 때 참고
OPENCLAW_RUNTIME=docker
OPENCLAW_GATEWAY_TOKEN=   # setup.sh가 자동 생성 (openssl rand -hex 32)
OPENCLAW_DISABLE_BONJOUR=1
OPENCLAW_HOME_VOLUME=openclaw_home

# 선택: bind-host 오버레이 대신 workspace 볼륨만 레포로 쓸 때는 보통 불필요
# docker compose -f docker-compose.yml -f docker-compose.bind-host.yml
# OPENCLAW_HOST_BIND=/Users/REPLACE_WITH_YOUR_USERNAME

# ============================================================
# llama.cpp 설정 (Mac 네이티브 실행 시 참조)
# ============================================================
LLAMACPP_DIR=/Users/REPLACE_WITH_YOUR_USERNAME/llama.cpp
LLAMACPP_HOST=0.0.0.0
LLAMACPP_PORT=8080
LLAMACPP_MODEL=/Users/REPLACE_WITH_YOUR_USERNAME/Workspace/Personal/localclaw/model/gemma-4-E4B-it-Q6_K.gguf
LLAMACPP_CTX_SIZE=32768
LLAMACPP_N_GPU_LAYERS=99
LLAMACPP_THREADS=   # 비워두면 스크립트가 자동 감지 (sysctl -n hw.physicalcpu)
LLAMACPP_BATCH_SIZE=512
LLAMACPP_UBATCH_SIZE=512
# 추가 llama-server 인자 (공백 구분). 예: --jinja (버전·모델에 따라 도구 템플릿 지원)
# LLAMACPP_EXTRA_ARGS=

# ============================================================
# 모델 설정
# ============================================================
MODELS_DIR=/Users/REPLACE_WITH_YOUR_USERNAME/Workspace/Personal/localclaw/model
MODEL_REPO=unsloth/gemma-4-E4B-it-GGUF
MODEL_FILE=gemma-4-E4B-it-Q6_K.gguf

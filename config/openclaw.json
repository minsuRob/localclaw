{
  "gateway": {
    "bind": "loopback",
    "auth": {
      "allowTailscale": true
    },
    "tailscale": {
      "mode": "funnel",
      "resetOnExit": false
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    },
    "corsOrigins": ["*"]
  },
  "models": {
    "providers": {
      "openai": {
        "baseURL": "http://host.docker.internal:8080/v1",
        "apiKey": "no-key-needed"
      }
    }
  }
}

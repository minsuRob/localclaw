{
  "browser": {
    "defaultProfile": "openclaw"
  },
  "tools": {
    "allow": ["group:openclaw"],
    "sandbox": {
      "tools": {
        "allow": [
          "group:runtime",
          "group:fs",
          "group:sessions",
          "group:memory",
          "group:web",
          "group:ui",
          "group:automation",
          "group:messaging",
          "group:nodes",
          "group:agents",
          "group:media"
        ]
      }
    }
  },
  "gateway": {
    "bind": "loopback",
    "auth": {
      "allowTailscale": true
    },
    "tailscale": {
      "mode": "funnel",
      "resetOnExit": false
    },
    "controlUi": {
      "allowedOrigins": [
        "https://minsurob.github.io",
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ]
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "models": {
    "providers": {
      "openai": {
        "baseUrl": "http://host.docker.internal:8080/v1",
        "api": "openai-completions",
        "apiKey": "no-key-needed",
        "models": [
          {
            "id": "gemma-4-E4B-it-Q6_K.gguf",
            "name": "Gemma 4 E4B Q6_K"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/Users/robertlee/Workspace/Personal/localclaw",
      "sandbox": {
        "mode": "off"
      }
    }
  }
}
